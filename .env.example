# Hacktrek WebCrawler — backend environment variables.
# Copy to `.env` and adjust as needed. All values below are the defaults used by
# api/server.py (Settings) and the supporting modules, so an empty/absent .env
# reproduces the out-of-the-box behaviour.

# --- CORS ------------------------------------------------------------------ #
# Comma-separated list of origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://hacktrek-web-crawler.vercel.app
# Only honoured when ALLOWED_ORIGINS contains no "*" wildcard.
ALLOW_CREDENTIALS=false

# --- Outbound HTTP fetches -------------------------------------------------- #
# Seconds before a target request times out.
REQUEST_TIMEOUT=10
# User-Agent sent with every outbound scan request.
USER_AGENT=Hacktrek-WebCrawler/2.1
# Maximum redirects to follow on a target request.
MAX_REDIRECTS=10

# --- DNS -------------------------------------------------------------------- #
# Comma-separated resolvers used for DNS lookups and subdomain resolution.
# Set to "system" to use the host's configured nameservers instead.
DNS_NAMESERVERS=8.8.8.8,1.1.1.1
# Seconds budget for DNS queries.
DNS_TIMEOUT=5

# --- TLS -------------------------------------------------------------------- #
# Seconds budget for the TLS handshake in the /tls inspector.
TLS_TIMEOUT=6

# --- Rate limiting (api/rate_limit.py) -------------------------------------- #
# Max requests per client IP per 60s window. 0 = disabled (default).
RATE_LIMIT_PER_MINUTE=0

# --- Response caching (api/cache.py) ---------------------------------------- #
# TTL in seconds for cached (endpoint, url) scan results. 0 = disabled (default).
SCAN_CACHE_TTL=0
